# MetaTrader 5 Web API Configuration
# Copy this file to .env and configure with your MT5 server details

# MT5 Server Connection
MT5_SERVER_IP=your.mt5server.com
MT5_SERVER_PORT=443
MT5_SERVER_WEB_LOGIN=your_web_api_login
MT5_SERVER_WEB_PASSWORD=your_web_api_password

# Optional: Package Configuration
MT5_AGENT=WorkbenchTest
MT5_SHOULD_CRYPT=true
MT5_SERVER_TIMEOUT=30

# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Laravel Configuration
LOG_CHANNEL=single
